# ==============================================================================
# PLACEMENTIQ Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure as needed for your environment.
# Never commit a .env file containing real secrets to version control.
# ==============================================================================

# Application Environment (development / staging / production)
ENVIRONMENT=development

# Database Connection URL
# SQLite default for local development. In production, use PostgreSQL URL.
DATABASE_URL=sqlite:///backend/placementiq.db

# JWT Authentication Placeholders (Reserved for future authentication pass)
# In production, replace with a strong cryptographically generated secret key.
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS Allowed Origins (comma-separated list or JSON array string)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
